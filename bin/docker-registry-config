#!/usr/bin/env bash
# Refresh a Docker config that can push to DOCR without Docker Desktop.
# Used by bin/deploy so buildx can share valid registry credentials.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ENV_FILE="$ROOT/.env"
OUT_DIR="$ROOT/.docker-kamal"
OUT_FILE="$OUT_DIR/config.json"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Missing $ENV_FILE — copy .env.example and set KAMAL_REGISTRY_PASSWORD" >&2
  exit 1
fi

PASS="$(grep '^KAMAL_REGISTRY_PASSWORD=' "$ENV_FILE" | cut -d= -f2-)"
if [[ -z "$PASS" ]]; then
  echo "KAMAL_REGISTRY_PASSWORD is empty in .env" >&2
  exit 1
fi

USER="${DO_REGISTRY_USERNAME:-arnold.roa@openrangedevs.com}"
AUTH="$(printf '%s:%s' "$USER" "$PASS" | base64 | tr -d '\n')"

mkdir -p "$OUT_DIR"
# Reuse host CLI plugins (buildx) from the default Docker config dir.
ln -sfn "${HOME}/.docker/cli-plugins" "$OUT_DIR/cli-plugins"

cat > "$OUT_FILE" <<EOF
{
  "auths": {
    "registry.digitalocean.com": {
      "auth": "${AUTH}"
    }
  }
}
EOF

echo "Wrote $OUT_FILE"
