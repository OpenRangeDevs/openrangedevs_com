#!/usr/bin/env bash
# Deploy via Kamal using registry credentials from .env.
# Avoids Docker Desktop credsStore 405 errors when the local daemon is down.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [[ ! -f "$ROOT/.env" ]]; then
  echo "Missing .env — copy .env.example and set required keys" >&2
  exit 1
fi

# ERB in config/deploy.yml reads ENV directly; ensure build-arg is present
# even if Kamal secrets load order changes.
if [[ -z "${WEB3FORM_ACCESS_KEY:-}" ]]; then
  WEB3FORM_ACCESS_KEY="$(grep '^WEB3FORM_ACCESS_KEY=' "$ROOT/.env" | cut -d= -f2-)"
  export WEB3FORM_ACCESS_KEY
fi

if [[ -z "${WEB3FORM_ACCESS_KEY:-}" ]]; then
  echo "WEB3FORM_ACCESS_KEY is empty in .env" >&2
  exit 1
fi

"$ROOT/bin/docker-registry-config"
export DOCKER_CONFIG="$ROOT/.docker-kamal"

exec kamal deploy "$@"
