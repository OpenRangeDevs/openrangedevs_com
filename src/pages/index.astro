---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero'
import ClientLogos from '../components/ClientLogos'
import FenceSection from '../components/FenceSection'
import SurveySection from '../components/SurveySection'
import ServicesSection from '../components/ServicesSection'
import CtaBanner from '../components/CtaBanner'
import TeamSection from '../components/TeamSection'
import FaqSection from '../components/FaqSection'
import Footer from '../components/Footer'
import { SITE, faqs } from '../data/site'

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
]
---

<BaseLayout schema={schema}>
  <!-- Old single-page links (#contact, #case-studies/<slug>) moved to real URLs.
       Hash fragments never reach the server, so this is the only place to redirect them. -->
  <script is:inline slot="head">
    ;(function () {
      var h = location.hash
      if (h === '#contact') location.replace('/contact/')
      var m = h.match(/^#case-studies\/([\w-]+)$/)
      if (m) location.replace('/case-studies/' + m[1] + '/')
    })()
  </script>

  <div class="page-rails relative min-h-screen overflow-x-clip">
    <div class="relative z-30">
      <Hero />
    </div>
    <div class="relative z-10">
      <ClientLogos />
    </div>
    <main class="relative z-10">
      <FenceSection />
      <SurveySection />
      <ServicesSection />
      <div class="pt-20">
        <CtaBanner
          title="Start with discovery."
          body="Map the business problem, define the strongest opportunity, and leave with a clear direction for what to build next."
          buttonLabel="Book discovery"
          backgroundImage="/assets/cta-discovery.png"
          motion="discovery"
        />
      </div>
      <div class="pt-[120px]">
        <TeamSection />
      </div>
      <FaqSection />
      <div class="py-[120px]">
        <CtaBanner
          title="Let's map your build."
          body="Tell us what you're trying to ship. We'll tell you whether we're the right outfit for it."
          buttonLabel="Book a Call"
          backgroundImage="/assets/cta-map-build.png"
        />
      </div>
    </main>
    <Footer onHome />
  </div>
</BaseLayout>
