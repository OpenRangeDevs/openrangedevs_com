---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import CaseStudyPage from '../../components/CaseStudyPage'
import { SITE } from '../../data/site'

export async function getStaticPaths() {
  const studies = await getCollection('case-studies')
  return studies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const study = entry.data
const url = new URL(`/case-studies/${entry.id}/`, SITE.url).href

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: study.title,
    description: study.description,
    url,
    about: study.project,
    author: { '@id': `${SITE.url}/#organization` },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: `${study.client} case study`, item: url },
    ],
  },
]
---

<BaseLayout
  title={`${study.client} case study: ${study.title.replace(/\.$/, '')}`}
  description={study.description}
  type="article"
  noindex={!study.published}
  schema={schema}
>
  <CaseStudyPage study={study} />
</BaseLayout>
