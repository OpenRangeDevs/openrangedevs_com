# Copy to .env and fill in. .env is gitignored.
# DigitalOcean API token with registry read/write (dop_v1_...).
KAMAL_REGISTRY_PASSWORD=

# Optional override (defaults to arnold.roa@openrangedevs.com)
# DO_REGISTRY_USERNAME=

# Web3Forms public access key (baked into the client bundle at build time).
WEB3FORM_ACCESS_KEY=
